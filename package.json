{
  "name": "dsh-zhouli",
  "version": "0.1.0",
  "description": "《周礼》插件：给 DeepSeek Harness 提供一个带稳定坐标（篇序.职官序）的全文检索工具，含职官员额/职掌索引与 Kanripo 两本互校勘记，并附一套依六官法度行事的 agent 预设。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data/*.json",
    "data/text",
    "preset",
    "scripts/*.py",
    "cordis.patch.yml",
    "检索.ps1",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "zhouli",
    "周礼",
    "rites-of-zhou",
    "chinese-classics",
    "agent-preset",
    "corpus"
  ],
  "license": "MIT",
  "author": "SCP-CN-1059",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCP-CN-1059/dsh-zhouli.git"
  },
  "homepage": "https://github.com/SCP-CN-1059/dsh-zhouli#readme",
  "bugs": {
    "url": "https://github.com/SCP-CN-1059/dsh-zhouli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "node scripts/check-pack.mjs",
    "fetch:data": "python scripts/fetch_corpus.py",
    "build:data": "python scripts/build_corpus.py --kanripo-only"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
